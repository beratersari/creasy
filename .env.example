HOST=0.0.0.0
PORT=9001

GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
WEBHOOK_SECRET=

OPENCODE_MODEL=opencode/big-pickle
OPENCODE_TIMEOUT=1800
OPENCODE_RETRY_COUNT=2
OPENCODE_AGENT=gitlab-reviewer
OPENCODE_BIN=opencode

MAX_CONCURRENT_JOBS=2
DATA_DIR=./data

SKIP_DRAFT_MRS=true

# Empty = open dashboard (dev). Set in production.
DASHBOARD_TOKEN=
LOG_LEVEL=INFO

# Optional Azure DevOps Server. Leave empty to keep GitLab-only.
# Service Hook URL: http://<creasy-host>:9001/webhook/azure
AZURE_DEVOPS_URL=
AZURE_DEVOPS_PAT=
# Optional. Independent of WEBHOOK_SECRET so GitLab and Azure can run together.
AZURE_WEBHOOK_USER=
AZURE_WEBHOOK_PASSWORD=
